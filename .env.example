# Local Docker Compose only. Copy to .env and set your own passwords.
MYSQL_DATABASE=like_spotify
MYSQL_USER=like_spotify
MYSQL_PASSWORD=change-me-local-app-password
MYSQL_ROOT_PASSWORD=change-me-local-root-password
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
# Optional: no key means local, tag-based mood mixes.
OPENAI_API_KEY=
# Choose a model in your account that supports Responses structured outputs.
OPENAI_MODEL=
